{
  "manifest_version": 3,
  "name": "Old YouTube",
  "version": "0.1.0",
  "description": "A calmer YouTube",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "action": {
    "default_title": "Old YouTube",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/toolbar-16.png", "24": "icons/toolbar-24.png", "32": "icons/toolbar-32.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["core.js", "thumbnails.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_start"
  }]
}
